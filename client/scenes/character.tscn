[gd_scene load_steps=3 format=3]

; Hero visual. ModelRoot is the fallback kit hero (class_presentations fallback_class, ADR-0018
; P3c); _apply_character_class_model swaps in the class model. character_visual.gd builds the gear
; sockets on the kit skeleton and installs the kit clip library (kit_hero_presentation) on the
; AnimationPlayer, whose root_node targets ModelRoot.
[ext_resource type="PackedScene" path="res://assets/characters/kaykit/knight.glb" id="1_glb"]
[ext_resource type="Script" path="res://scripts/character_visual.gd" id="2_script"]

[node name="CharacterVisual" type="Node3D"]
script = ExtResource("2_script")

[node name="ModelRoot" parent="." instance=ExtResource("1_glb")]
transform = Transform3D(0.8, 0, 0, 0, 0.8, 0, 0, 0, 0.8, 0, 0, 0)

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("../ModelRoot")
