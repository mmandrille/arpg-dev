{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpg.dev/schemas/assets/town_presentation.v0.schema.json",
  "title": "Town presentation (v0)",
  "description": "Client and tooling tuning for level-0 town perimeter and night mood.",
  "type": "object",
  "required": [
    "version",
    "center",
    "radius_m",
    "segment_count",
    "gate_heading",
    "gate_gap_segments",
    "wall_kind",
    "wall_thickness",
    "gate_position"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 0
    },
    "center": {
      "$ref": "#/$defs/position"
    },
    "radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "segment_count": {
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    },
    "gate_heading": {
      "type": "string",
      "enum": [
        "south",
        "north",
        "east",
        "west"
      ]
    },
    "gate_gap_segments": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "wall_kind": {
      "type": "string",
      "enum": [
        "wood",
        "wall"
      ]
    },
    "wall_thickness": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "gate_position": {
      "$ref": "#/$defs/position"
    },
    "night_lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directional_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "directional_energy": {
          "type": "number",
          "minimum": 0
        },
        "ambient_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ambient_energy": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "dressing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "plaza",
        "min_clearance_m",
        "props"
      ],
      "description": "v491: presentation-only town dressing (paved plaza + road to the gate, kit props). The server does not know these; tools/test_town_dressing.py keeps them clear of gameplay positions.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "plaza": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius_m",
            "path_width_m",
            "surface_y",
            "tile_variants"
          ],
          "properties": {
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "path_width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "surface_y": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "tile_scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2
            },
            "tile_variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "weight"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "rim": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width_m",
                "tile_variants"
              ],
              "properties": {
                "width_m": {
                  "type": "number",
                  "minimum": 0
                },
                "tile_variants": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "asset_id",
                      "weight"
                    ],
                    "properties": {
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "weight": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "min_clearance_m": {
          "type": "number",
          "minimum": 0
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "position"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "yaw_degrees": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3
              }
            }
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "service_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path_width_m",
            "targets"
          ],
          "properties": {
            "path_width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "targets": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "width_m",
            "surface_y",
            "tile_variants"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "width_m": {
              "type": "number",
              "minimum": 0
            },
            "surface_y": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "tile_variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "weight"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "ground_size_m", "soil_color", "blend_width_m", "footprint_margin_m", "noise_scale_per_m", "noise_amplitude_m"],
          "properties": {
            "enabled": {"type": "boolean"},
            "ground_size_m": {"$ref": "#/$defs/position"},
            "soil_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "blend_width_m": {"type": "number", "exclusiveMinimum": 0},
            "footprint_margin_m": {"type": "number", "minimum": 0},
            "noise_scale_per_m": {"type": "number", "exclusiveMinimum": 0},
            "noise_amplitude_m": {"type": "number", "minimum": 0}
          }
        },
        "nature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "fence_clearance_m", "anchor_clearance_m", "gate_approach", "groups"],
          "properties": {
            "enabled": {"type": "boolean"},
            "fence_clearance_m": {"type": "number", "minimum": 0},
            "anchor_clearance_m": {"type": "number", "minimum": 0},
            "gate_approach": {
              "type": "object",
              "additionalProperties": false,
              "required": ["end_position", "half_width_m"],
              "properties": {
                "end_position": {"$ref": "#/$defs/position"},
                "half_width_m": {"type": "number", "minimum": 0}
              }
            },
            "groups": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "center", "radius_m", "seed_salt", "cell_m", "occupancy_percent", "landmarks", "variants"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "center": {"$ref": "#/$defs/position"},
                  "radius_m": {"type": "number", "exclusiveMinimum": 0},
                  "seed_salt": {"type": "integer"},
                  "cell_m": {"type": "number", "exclusiveMinimum": 0},
                  "occupancy_percent": {"type": "integer", "minimum": 0, "maximum": 100},
                  "landmarks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nature_landmark"}},
                  "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nature_variant"}}
                }
              }
            }
          }
        },
        "scatter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "radius_m",
            "cell_m",
            "occupancy_percent",
            "patch_share_percent",
            "min_clearance_m",
            "fence_clearance_m",
            "jitter_fraction",
            "surface_y",
            "patches",
            "rocks"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cell_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "occupancy_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "patch_share_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "min_clearance_m": {
              "type": "number",
              "minimum": 0
            },
            "fence_clearance_m": {
              "type": "number",
              "minimum": 0
            },
            "jitter_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "surface_y": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "patches": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "weight",
                  "radius_m",
                  "scale_min",
                  "scale_max"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale_min": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale_max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "rocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "weight",
                  "radius_m",
                  "scale_min",
                  "scale_max"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale_min": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale_max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "ambient_life": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "actor_clearance_m",
            "prop_clearance_m",
            "anchor_clearance_m",
            "service_path_margin_m",
            "fence_clearance_m",
            "gate_approach_clearance_m",
            "actors"
          ],
          "description": "v506 client-only ambient residents. Their positions and patrols remain clear of gameplay anchors and travel paths.",
          "properties": {
            "enabled": {"type": "boolean"},
            "actor_clearance_m": {"type": "number", "exclusiveMinimum": 0},
            "prop_clearance_m": {"type": "number", "exclusiveMinimum": 0},
            "anchor_clearance_m": {"type": "number", "exclusiveMinimum": 0},
            "service_path_margin_m": {"type": "number", "minimum": 0},
            "fence_clearance_m": {"type": "number", "minimum": 0},
            "gate_approach_clearance_m": {"type": "number", "minimum": 0},
            "actors": {
              "type": "array",
              "maxItems": 4,
              "items": {"$ref": "#/$defs/ambient_actor"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nature_landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "position", "scale", "yaw_degrees", "footprint_radius_m"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/position"},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "yaw_degrees": {"type": "number"},
        "footprint_radius_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "nature_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "weight", "scale_min", "scale_max", "footprint_radius_m"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 1},
        "scale_min": {"type": "number", "exclusiveMinimum": 0},
        "scale_max": {"type": "number", "exclusiveMinimum": 0},
        "footprint_radius_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "ambient_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class_id", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "class_id": {"type": "string", "enum": ["barbarian", "sorcerer", "paladin", "rogue", "ranger"]},
        "mode": {"type": "string", "enum": ["idle", "patrol"]},
        "position": {"$ref": "#/$defs/position"},
        "yaw_degrees": {"type": "number", "minimum": -360, "maximum": 360},
        "path": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/position"}
        },
        "speed_mps": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "pause_s": {"type": "number", "minimum": 0, "maximum": 20},
        "phase_s": {"type": "number", "minimum": 0, "maximum": 60}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "idle"}}, "required": ["mode"]},
          "then": {"required": ["position", "yaw_degrees"]}
        },
        {
          "if": {"properties": {"mode": {"const": "patrol"}}, "required": ["mode"]},
          "then": {"required": ["path", "speed_mps", "pause_s", "phase_s"]}
        }
      ]
    },
    "position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
