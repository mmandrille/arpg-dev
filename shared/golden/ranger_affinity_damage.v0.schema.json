{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpg.dev/schemas/golden/ranger_affinity_damage.v0.schema.json",
  "type": "object",
  "required": ["rule", "cases"],
  "additionalProperties": false,
  "properties": {
    "rule": { "$ref": "#/$defs/rule" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "rank", "effective_stat", "affinities", "raw_min", "raw_max", "expected_percent", "expected_min", "expected_max"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 0 },
          "effective_stat": { "type": "integer" },
          "affinities": { "type": "integer", "minimum": 0 },
          "raw_min": { "type": "integer", "minimum": 0 },
          "raw_max": { "type": "integer", "minimum": 0 },
          "expected_percent": { "type": "integer", "minimum": 0, "maximum": 25 },
          "expected_min": { "type": "integer", "minimum": 0 },
          "expected_max": { "type": "integer", "minimum": 0 },
          "rule_override": { "$ref": "#/$defs/rule" }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["affinity_stat", "base_percent_per_affinity", "stat_points_per_extra_percent", "max_active_affinities", "max_bonus_percent"],
      "additionalProperties": false,
      "properties": {
        "affinity_stat": { "type": "string", "enum": ["str", "dex", "vit", "magic"] },
        "base_percent_per_affinity": { "type": "integer", "minimum": 0, "maximum": 10 },
        "stat_points_per_extra_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_active_affinities": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_bonus_percent": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    }
  }
}
