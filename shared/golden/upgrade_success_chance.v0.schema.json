{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpg.dev/schemas/golden/upgrade_success_chance.v0.schema.json",
  "title": "Golden: upgrade success chance (v0)",
  "type": "object",
  "required": ["curve", "shard_bonus_percent_per_tier", "cases"],
  "additionalProperties": false,
  "properties": {
    "curve": {
      "type": "object",
      "required": ["safe_target_level_max", "level_anchors", "failure_chance_percent_anchors"],
      "additionalProperties": false,
      "properties": {
        "safe_target_level_max": { "type": "integer", "minimum": 0 },
        "level_anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "failure_chance_percent_anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "shard_bonus_percent_per_tier": { "type": "integer", "minimum": 0, "maximum": 100 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["current_level", "shard_level", "success_percent"],
        "additionalProperties": false,
        "properties": {
          "current_level": { "type": "integer", "minimum": 0 },
          "shard_level": { "type": "integer", "minimum": 1 },
          "success_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
