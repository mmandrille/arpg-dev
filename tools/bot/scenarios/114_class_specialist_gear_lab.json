      "item_def_id": "skull_face",
      "item_template_id": "skull_face",
      "stat_keys": ["damage_min"]
    },
    {
      "action": "equip_inventory_item",
      "item_def_id": "skull_face",
      "slot": "head"
    },
    {
      "action": "pick_up_loot",
      "item_def_id": "war_bracers"
    },
    {
      "action": "assert_inventory_requirement_status",
      "item_def_id": "war_bracers",
      "requirements_met": true,
      "status": [
        {
          "stat": "class",
          "required": 1,
          "current": 1,
          "met": true
        }
      ]
    },
    {
      "action": "equip_inventory_item",
      "item_def_id": "war_bracers",
      "slot": "gloves"
    },
    {
      "action": "pick_up_loot",
      "item_def_id": "holy_scepter"
    },
    {
      "action": "assert_inventory_requirement_status",
      "item_def_id": "holy_scepter",
      "requirements_met": false,
      "status": [
        {
          "stat": "class",
          "required": 1,
          "current": 0,
          "met": false
        }
      ]
    },
    {
      "action": "equip_inventory_item",
      "item_def_id": "holy_scepter",
      "slot": "main_hand",
      "expect_reject": "class_requirement_not_met"
    }
  ]
