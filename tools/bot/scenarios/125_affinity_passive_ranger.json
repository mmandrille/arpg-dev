    { "action": "pick_up_loot", "item_def_id": "affinity_compound_bow" },
    { "action": "pick_up_loot", "item_def_id": "affinity_ranger_quiver" },
    { "action": "assert_rolled_inventory_item", "item_def_id": "affinity_compound_bow", "item_template_id": "affinity_compound_bow", "class_affinity_active_count": 1 },
