    { "action": "unequip_slot", "slot": "main_hand" },
    { "action": "assert_character_progression", "derived_stats": { "ranged_damage_bonus_percent": 0 } }
  ],
  "assertions": [
    { "type": "skill_progression", "unspent_skill_points": 0, "skill_id": "deadeye", "rank": 1, "max_rank": "from_rules", "can_spend": false },
