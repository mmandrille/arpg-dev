{
  "id": "eye_view_weapon_presentation",
  "ci_tier": "extended",
  "runner": "godot_client",
  "world_id": "combat_control_lab",
  "seed": "eyeviewweapon01",
  "title": "Chest-view camera: equip a bow and fire from the perspective camera",
  "description": "Switch to the chest-view perspective camera, equip the combat lab training bow, and fire once at a monster. The v468 real-body view has no separate first-person weapon rig, so the proof is the camera mode, the equipped slot and an authoritative attack result.",
  "client_steps": [
    {
      "type": "wait_ws_open",
      "timeout_s": 10.0
    },
    {
      "type": "set_camera_mode",
      "mode": "chest_view"
    },
    {
      "type": "wait_ticks",
      "ticks": 2,
      "timeout_s": 2.0
    },
    {
      "type": "assert_camera_mode",
      "mode": "chest_view",
      "projection": "perspective"
    },
    {
      "type": "assert_wall_occlusion",
      "active": false,
      "faded_wall_count": 0
    },
    {
      "type": "click_loot_item",
      "item_def_id": "training_bow"
    },
    {
      "type": "wait_inventory_item",
      "item_def_id": "training_bow",
      "timeout_s": 10.0
    },
    {
      "type": "drag_bag_to_weapon_slot",
      "item_def_id": "training_bow"
    },
    {
      "type": "wait_event",
      "event_type": "item_equipped",
      "timeout_s": 10.0
    },
    {
      "type": "assert_equipped",
      "slot": "main_hand"
    },
    {
      "type": "wait_entity",
      "entity_type": "monster",
      "monster_def_id": "dungeon_mob",
      "timeout_s": 10.0
    },
    {
      "type": "click_entity",
      "entity_type": "monster",
      "monster_def_id": "dungeon_mob"
    },
    {
      "type": "wait_event",
      "event_types": [
        "monster_damaged",
        "attack_missed"
      ],
      "target_entity_type": "monster",
      "target_monster_def_id": "dungeon_mob",
      "timeout_s": 8.0
    }
  ]
}
